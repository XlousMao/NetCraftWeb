# ===== GEAP 环境变量模板 =====
# 复制为 .env 后按需修改（Docker Compose 与本地开发共用）

# ---- 数据库 ----
# 本地开发（默认 SQLite，零依赖，适合快速启动）
DATABASE_URL=sqlite:///./geap.db
# Docker / 生产（PostgreSQL）
# DATABASE_URL=postgresql+psycopg://geap:geap@localhost:5432/geap

# ---- Redis（MVP 可选，不配置则缓存层自动降级为 no-op）----
REDIS_URL=redis://localhost:6379/0

# ---- 安全 ----
SECRET_KEY=change-me-in-production

# ---- 文件存储目录 ----
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads

# ---- 上传限制（字节）----
MAX_UPLOAD_SIZE=10485760

# ---- CORS ----
CORS_ORIGINS=*

# ---- DeepSeek AI 分析（不填则 AI 层降级为本地结构化摘要）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 数据库备份 ----
BACKUP_DIR=./backups
